# Copy to .env.local for local overrides. Never commit real secrets.

# Optional. Base URL of SUTRAN's public alert API (no credentials required).
# Defaults to https://api.sigea.sutran.gob.pe/public when empty.
SUTRAN_API_BASE=

# Optional. Base URL of the Open-Meteo forecast API (free tier, non-commercial, CC BY 4.0).
# Defaults to https://api.open-meteo.com/v1 when empty.
OPEN_METEO_BASE=

# Server-only Supabase Postgres connection; use the scoped peruroad_backend login.
DATABASE_URL=
# verify-full for Supabase; disable is restricted to local database tests.
DATABASE_SSL_MODE=
# Optional pinned PE-22 geometry revision; defaults to the documented imported revision.
ROAD_DATA_GEOMETRY_REVISION=
# AES-256 key encoded as 43 base64url characters. Generate 32 random bytes.
CONTACT_ENCRYPTION_KEY=
# Encryption envelope version; defaults to v1. Retain old keys when rotating persisted contacts.
CONTACT_KEY_VERSION=
# Independent HMAC secret, at least 32 characters. Changing it changes every phone identifier.
PHONE_KEY_PEPPER=
# Independent secret for company access-code digests and signed cookies (at least 32 characters).
SESSION_SIGNING_SECRET=
# Optional comma-separated HMAC phone identifiers for team/test exclusions; never raw phone numbers.
TEAM_PHONE_KEYS=
TEST_PHONE_KEYS=
# Server-only seeding input; random access code, at least 16 characters. Not needed by the deployed app.
DEMO_ACCESS_CODE=
# Optional Realtime configuration. Only this publishable key is returned to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Set automatically by Vercel. Only that runtime trusts its overwritten client-IP header.
VERCEL=
