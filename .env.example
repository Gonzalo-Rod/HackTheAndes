# Copy to .env.local for local overrides. Never commit real secrets.

# Optional. Base URL of SUTRAN's public alert API (no credentials required).
# Defaults to https://api.sigea.sutran.gob.pe/public when empty.
SUTRAN_API_BASE=

# Optional. Base URL of the Open-Meteo forecast API (free tier, non-commercial, CC BY 4.0).
# Defaults to https://api.open-meteo.com/v1 when empty.
OPEN_METEO_BASE=

# Server-only Supabase Postgres connection; use the scoped peruroad_backend login.
DATABASE_URL=
# verify-full for Supabase; disable is restricted to local database tests.
DATABASE_SSL_MODE=
# Optional pinned PE-22 geometry revision; defaults to the documented imported revision.
ROAD_DATA_GEOMETRY_REVISION=
# AES-256 key encoded as 43 base64url characters. Generate 32 random bytes.
CONTACT_ENCRYPTION_KEY=
# Encryption envelope version; defaults to v1. Retain old keys when rotating persisted contacts.
CONTACT_KEY_VERSION=
# Independent HMAC secret, at least 32 characters. Changing it changes every phone identifier.
PHONE_KEY_PEPPER=
# Independent secret for company access-code digests and signed cookies (at least 32 characters).
SESSION_SIGNING_SECRET=
# Optional comma-separated HMAC phone identifiers for team/test exclusions; never raw phone numbers.
TEAM_PHONE_KEYS=
TEST_PHONE_KEYS=
# Server-only seeding input; random access code, at least 16 characters. Not needed by the deployed app.
DEMO_ACCESS_CODE=
# Optional Realtime configuration. Only this publishable key is returned to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Set automatically by Vercel. Only that runtime trusts its overwritten client-IP header.
VERCEL=

# Server-only Zavu API credential for the WhatsApp/messaging integration.
ZAVU_API_KEY=
# Server-only signing secret of the RECEIVING WhatsApp sender (not the default outbound sender).
ZAVU_WEBHOOK_SECRET=
# Server-only configured Zavu sender identifier.
ZAVU_SENDER_ID=
# Server-only OpenAI API credential for extraction and grounded explanations.
OPENAI_API_KEY=
# Optional intent/extraction model snapshot. Defaults to gpt-4.1-mini-2025-04-14. No generated risk answers.
OPENAI_INTENT_MODEL=
# Public dashboard origin included in WhatsApp replies. Default: current shared feature Preview.
# Set the production origin before activating the Production webhook.
PUBLIC_APP_URL=
# Optional public WhatsApp number of the bot, with country code (e.g. 51…). Shown as "chat" buttons on the dashboard; unset hides them.
WHATSAPP_BOT_NUMBER=
# Optional audio transcription model. Uses the existing server-only OpenAI credential.
OPENAI_TRANSCRIPTION_MODEL=
# Optional approved Zavu utility template for alerts outside the WhatsApp service window.
ZAVU_ALERT_TEMPLATE_ID=
# Server-only n8n authorization secret (reuse the existing ingestion job credential).
ROAD_DATA_JOB_SECRET=

# Approved WhatsApp utility notice asking weekly-PDF subscribers to reply PDF outside the 24-hour window.
ZAVU_WEEKLY_REPORT_TEMPLATE_ID=

# Server-only Qatom managed-agent connection. Copy the MCP URL and resource from its connection settings.
QATOM_MCP_URL=
# Managed-agent OAuth client (agent_...), entered by the account owner in the hosting secret store.
# Tokens are obtained via client_credentials, cached and renewed automatically before expiry.
QATOM_CLIENT_ID=
QATOM_CLIENT_SECRET=
# The dedicated weekly-alert catalog item, priced exactly 0.50 USD-TDN to match qatom/catalog.json. Never reuse the test-only item.
QATOM_CATALOG_ITEM_ID=
# USD-TDN digital quantity hash used by this seller. Verifies the currency of settled sales.
QATOM_USD_TDN_DQ=
# Random independent secret (32+ characters). Also set the item's sensitive Authorization fulfilment header to Bearer <token>.
QATOM_FULFILMENT_TOKEN=
# Optional Responses API model for the Qatom guest_checkout tool; defaults to the existing GPT-4.1 mini snapshot.
OPENAI_QATOM_MODEL=

# Seller ACCOUNT API credentials for server-side settled-sale verification. Agent credentials cannot call the REST API.
QATOM_API_CLIENT_ID=
QATOM_API_CLIENT_SECRET=
