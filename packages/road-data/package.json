{
  "name": "@peruroad/road-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sutran:check": "node scripts/check-sutran.ts",
    "lint": "eslint src tests scripts vitest*.config.ts --max-warnings=0",
    "format": "prettier --write src tests scripts package.json package-lock.json tsconfig.json tsconfig.build.json vitest*.config.ts eslint.config.mjs .prettierrc.json README.md ../../workflows/n8n",
    "format:check": "prettier --check src tests scripts package.json package-lock.json tsconfig.json tsconfig.build.json vitest*.config.ts eslint.config.mjs .prettierrc.json README.md ../../workflows/n8n",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "npm run build",
    "test:exports": "node --input-type=module -e \"await import('@peruroad/road-data'); await import('@peruroad/road-data/contracts'); await import('@peruroad/road-data/ingestion'); await import('@peruroad/road-data/geometry'); await import('@peruroad/road-data/geometry/contracts'); await import('@peruroad/road-data/database'); await import('@peruroad/road-data/jobs'); await import('@peruroad/road-data/elevation'); await import('@peruroad/road-data/elevation/contracts'); await import('@peruroad/road-data/locations'); await import('@peruroad/road-data/locations/contracts'); await import('@peruroad/road-data/context'); await import('@peruroad/road-data/context/contracts'); await import('@peruroad/road-data/catchments'); await import('@peruroad/road-data/catchments/contracts'); await import('@peruroad/road-data/weather'); await import('@peruroad/road-data/weather/contracts'); await import('@peruroad/road-data/model-inputs'); await import('@peruroad/road-data/model-inputs/spatial-contracts'); await import('@peruroad/road-data/model-inputs/event-contracts'); await import('@peruroad/road-data/training'); await import('@peruroad/road-data/training/contracts'); await import('@peruroad/road-data/exposure'); await import('@peruroad/road-data/exposure/contracts'); await import('@peruroad/road-data/road-history'); await import('@peruroad/road-data/road-history/contracts'); await import('@peruroad/road-data/official-warnings');\"",
    "pe22:prepare": "node scripts/prepare-pe22.ts",
    "road:prepare": "node scripts/prepare-road.ts",
    "road:import": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/import-road.ts",
    "senamhi:check": "node scripts/check-senamhi.ts",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate-database.ts",
    "supabase:configure": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/bootstrap-supabase.ts",
    "db:import-pe22": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/import-pe22.ts",
    "sutran:ingest": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/ingest-sutran.ts",
    "db:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-database.ts",
    "test:db": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.database.config.ts",
    "sutran:job:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-sutran-job.ts",
    "pe22:elevation": "node scripts/prepare-pe22-elevation.ts",
    "db:import-elevation": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/import-pe22-elevation.ts",
    "pe22:gazetteer": "node scripts/prepare-pe22-gazetteer.ts",
    "db:import-gazetteer": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/import-pe22-gazetteer.ts",
    "road-context:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-road-context.ts",
    "catchments:download": "node scripts/download-hydrobasins.ts && node scripts/capture-hydrography.ts",
    "catchments:prepare": ".venv/bin/python python/prepare_catchments.py --output data/.cache/catchments-candidate.json && node scripts/validate-catchments.ts",
    "db:import-catchments": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/import-catchments.ts",
    "weather:capture": "node scripts/capture-catchment-weather.ts",
    "db:import-weather": "node --env-file-if-exists=.env.local scripts/import-weather.ts",
    "hazards:capture": "node scripts/capture-hazards.ts",
    "terrain:capture": "node scripts/capture-catchment-terrain.ts",
    "hydrography:capture": "node scripts/capture-hydrographic-units.ts",
    "hazards:prepare": ".venv/bin/python python/prepare_hazards.py && node scripts/validate-hazards.ts",
    "events:capture": "node scripts/capture-historical-events.ts",
    "events:prepare": ".venv/bin/python python/prepare_historical_events.py && node scripts/validate-historical-events.ts",
    "events:prepare-national": "python3 python/prepare_national_events.py && node scripts/validate-national-events.ts",
    "db:import-model-inputs": "node --env-file-if-exists=.env.local scripts/import-model-inputs.ts",
    "model-inputs:check": "node scripts/check-model-inputs.ts",
    "ml:labels:check": "node scripts/check-training-labels.ts",
    "ml:prepare": "node scripts/prepare-logistic-dataset.ts",
    "ml:train": "node scripts/run-logistic.ts train",
    "ml:evaluate": "node scripts/run-logistic.ts evaluate",
    "exposure:prepare": "node scripts/prepare-exposure.ts",
    "db:import-exposure": "node --env-file-if-exists=.env.local scripts/import-exposure.ts"
  },
  "dependencies": {
    "@turf/length": "^7.4.0",
    "@turf/line-slice-along": "^7.4.0",
    "@turf/nearest-point-on-line": "^7.4.0",
    "pg": "^8.23.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "description": "Data-source adapters and model building blocks for PeruRoad Climate",
  "types": "./dist/integrations/sutran/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/integrations/sutran/index.d.ts",
      "default": "./dist/integrations/sutran/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/road-alerts.d.ts",
      "default": "./dist/contracts/road-alerts.js"
    },
    "./ingestion": {
      "types": "./dist/services/index.d.ts",
      "default": "./dist/services/index.js"
    },
    "./geometry": {
      "types": "./dist/geometry.d.ts",
      "default": "./dist/geometry.js"
    },
    "./geometry/contracts": {
      "types": "./dist/contracts/road-geometry.d.ts",
      "default": "./dist/contracts/road-geometry.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "default": "./dist/database.js"
    },
    "./jobs": {
      "types": "./dist/jobs.d.ts",
      "default": "./dist/jobs.js"
    },
    "./elevation": {
      "types": "./dist/elevation.d.ts",
      "default": "./dist/elevation.js"
    },
    "./elevation/contracts": {
      "types": "./dist/contracts/road-elevation.d.ts",
      "default": "./dist/contracts/road-elevation.js"
    },
    "./locations": {
      "types": "./dist/locations.d.ts",
      "default": "./dist/locations.js"
    },
    "./locations/contracts": {
      "types": "./dist/contracts/road-locations.d.ts",
      "default": "./dist/contracts/road-locations.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    },
    "./context/contracts": {
      "types": "./dist/contracts/road-context.d.ts",
      "default": "./dist/contracts/road-context.js"
    },
    "./catchments": {
      "types": "./dist/catchments.d.ts",
      "default": "./dist/catchments.js"
    },
    "./catchments/contracts": {
      "types": "./dist/contracts/road-catchments.d.ts",
      "default": "./dist/contracts/road-catchments.js"
    },
    "./weather": {
      "types": "./dist/weather.d.ts",
      "default": "./dist/weather.js"
    },
    "./weather/contracts": {
      "types": "./dist/contracts/catchment-weather.d.ts",
      "default": "./dist/contracts/catchment-weather.js"
    },
    "./model-inputs": {
      "types": "./dist/model-inputs.d.ts",
      "default": "./dist/model-inputs.js"
    },
    "./model-inputs/spatial-contracts": {
      "types": "./dist/contracts/spatial-inputs.d.ts",
      "default": "./dist/contracts/spatial-inputs.js"
    },
    "./model-inputs/event-contracts": {
      "types": "./dist/contracts/historical-events.d.ts",
      "default": "./dist/contracts/historical-events.js"
    },
    "./training": {
      "types": "./dist/training.d.ts",
      "default": "./dist/training.js"
    },
    "./training/contracts": {
      "types": "./dist/contracts/logistic-training.d.ts",
      "default": "./dist/contracts/logistic-training.js"
    },
    "./exposure": {
      "types": "./dist/exposure.d.ts",
      "default": "./dist/exposure.js"
    },
    "./exposure/contracts": {
      "types": "./dist/contracts/exposure-public.d.ts",
      "default": "./dist/contracts/exposure-public.js"
    },
    "./reports": {
      "types": "./dist/reports.d.ts",
      "default": "./dist/reports.js"
    },
    "./road-history": {
      "types": "./dist/road-history.d.ts",
      "default": "./dist/road-history.js"
    },
    "./road-history/contracts": {
      "types": "./dist/contracts/national-road-events.d.ts",
      "default": "./dist/contracts/national-road-events.js"
    },
    "./official-warnings": {
      "types": "./dist/official-warnings.d.ts",
      "default": "./dist/official-warnings.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "certs",
    "data/pe22/catchments.json",
    "data/weather",
    "data/pe22/hazards.json",
    "data/pe22/catchment-terrain.json",
    "data/events",
    "data/spatial",
    "data/exposure",
    "data/pe22/segments-1km.geojson",
    "data/roads/registry.json",
    "data/roads/*/exposure.json.gz"
  ]
}
