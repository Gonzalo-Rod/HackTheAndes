{
  "name": "@peruroad/road-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sutran:check": "node scripts/check-sutran.ts",
    "lint": "eslint src tests scripts vitest*.config.ts --max-warnings=0",
    "format": "prettier --write src tests scripts package.json package-lock.json tsconfig.json tsconfig.build.json vitest*.config.ts eslint.config.mjs .prettierrc.json README.md ../../workflows/n8n",
    "format:check": "prettier --check src tests scripts package.json package-lock.json tsconfig.json tsconfig.build.json vitest*.config.ts eslint.config.mjs .prettierrc.json README.md ../../workflows/n8n",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "npm run build",
    "test:exports": "node --input-type=module -e \"await import('@peruroad/road-data'); await import('@peruroad/road-data/contracts'); await import('@peruroad/road-data/ingestion'); await import('@peruroad/road-data/geometry'); await import('@peruroad/road-data/geometry/contracts'); await import('@peruroad/road-data/database'); await import('@peruroad/road-data/jobs'); await import('@peruroad/road-data/elevation'); await import('@peruroad/road-data/elevation/contracts'); await import('@peruroad/road-data/locations'); await import('@peruroad/road-data/locations/contracts'); await import('@peruroad/road-data/context'); await import('@peruroad/road-data/context/contracts');\"",
    "pe22:prepare": "node scripts/prepare-pe22.ts",
    "senamhi:check": "node scripts/check-senamhi.ts",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate-database.ts",
    "supabase:configure": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/bootstrap-supabase.ts",
    "db:import-pe22": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/import-pe22.ts",
    "sutran:ingest": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/ingest-sutran.ts",
    "db:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-database.ts",
    "test:db": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.database.config.ts",
    "sutran:job:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-sutran-job.ts",
    "pe22:elevation": "node scripts/prepare-pe22-elevation.ts",
    "db:import-elevation": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/import-pe22-elevation.ts",
    "pe22:gazetteer": "node scripts/prepare-pe22-gazetteer.ts",
    "db:import-gazetteer": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/import-pe22-gazetteer.ts",
    "road-context:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-road-context.ts"
  },
  "dependencies": {
    "@turf/length": "^7.4.0",
    "@turf/line-slice-along": "^7.4.0",
    "@turf/nearest-point-on-line": "^7.4.0",
    "pg": "^8.23.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "description": "Data-source adapters and model building blocks for PeruRoad Climate",
  "types": "./dist/integrations/sutran/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/integrations/sutran/index.d.ts",
      "default": "./dist/integrations/sutran/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/road-alerts.d.ts",
      "default": "./dist/contracts/road-alerts.js"
    },
    "./ingestion": {
      "types": "./dist/services/index.d.ts",
      "default": "./dist/services/index.js"
    },
    "./geometry": {
      "types": "./dist/geometry.d.ts",
      "default": "./dist/geometry.js"
    },
    "./geometry/contracts": {
      "types": "./dist/contracts/road-geometry.d.ts",
      "default": "./dist/contracts/road-geometry.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "default": "./dist/database.js"
    },
    "./jobs": {
      "types": "./dist/jobs.d.ts",
      "default": "./dist/jobs.js"
    },
    "./elevation": {
      "types": "./dist/elevation.d.ts",
      "default": "./dist/elevation.js"
    },
    "./elevation/contracts": {
      "types": "./dist/contracts/road-elevation.d.ts",
      "default": "./dist/contracts/road-elevation.js"
    },
    "./locations": {
      "types": "./dist/locations.d.ts",
      "default": "./dist/locations.js"
    },
    "./locations/contracts": {
      "types": "./dist/contracts/road-locations.d.ts",
      "default": "./dist/contracts/road-locations.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    },
    "./context/contracts": {
      "types": "./dist/contracts/road-context.d.ts",
      "default": "./dist/contracts/road-context.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "certs"
  ]
}
