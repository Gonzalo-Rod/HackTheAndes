# Public SUTRAN reads and geometry preparation need no credentials.
# Management-only personal access token; never deploy it as an application key.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Project API settings; only the publishable key is suitable for browser clients.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only key. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Scoped peruroad_backend connection; generated locally by supabase:configure.
DATABASE_URL=
# Defaults to verify-full. disable is accepted only for loopback test databases.
DATABASE_SSL_MODE=

# Server-only random base64url secret, at least 32 characters. Share only with n8n credentials.
ROAD_DATA_JOB_SECRET=

# Server-to-server read interface for member B; distinct from the n8n job secret.
ROAD_DATA_API_SECRET=
# API origin used by the member B client; HTTPS outside loopback development.
ROAD_DATA_API_URL=
# Optional: reviewed road revision for the read API; empty uses the versioned PE-22 default.
ROAD_DATA_GEOMETRY_REVISION=
